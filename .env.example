# basis-gateway — example environment configuration
#
# Copy this file to .env and fill in values for your environment.
# Never commit a .env file containing real secrets or tokens.
#
# Evaluation is enabled when OIDC_ISSUER is set (AUTH_MODE=oidc, the default)
# or when AUTH_MODE=basis_local_token is explicitly selected. In either case,
# POLICY_PATH is also required or the service will not become ready.

# ── Service identity ──────────────────────────────────────────────────────────
SERVICE_NAME=basis-gateway
ENVIRONMENT=local
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── Authentication mode ───────────────────────────────────────────────────────
# Which verifier authenticates Bearer tokens at /v1/evaluate: "oidc" (default,
# below) or "basis_local_token" (see the BASIS-local token trust section
# further down). Explicit configuration only — never inferred from the token.
# AUTH_MODE=oidc

# ── OIDC / JWT (AUTH_MODE=oidc, the default) ─────────────────────────────────
# Required to enable POST /v1/evaluate in "oidc" mode.
# The issuer URL is used for OIDC discovery (/.well-known/openid-configuration)
# and for validating the `iss` claim in incoming tokens.
OIDC_ISSUER=https://your-idp.example.com/realms/your-realm

# Expected audience claim in incoming tokens. Leave unset to skip audience validation.
OIDC_AUDIENCE=basis-gateway

# Optional: override the JWKS URI when OIDC discovery is unavailable.
# OIDC_JWKS_URI=https://your-idp.example.com/realms/your-realm/protocol/openid-connect/certs

# JWKS in-memory cache TTL in seconds (default: 300).
# JWKS_CACHE_TTL_SECONDS=300

# ── BASIS-local token trust (AUTH_MODE=basis_local_token only) ──────────────
# Not required (and not validated) unless AUTH_MODE=basis_local_token.
# See docs/basis-local-token-trust.md for the verifier this configures.
# BASIS_LOCAL_TOKEN_ISSUER=https://identity.basis.example.com
# BASIS_LOCAL_TOKEN_AUDIENCE=basis-gateway
#
# JSON object string mapping key id to PEM-encoded public key (comma-separate
# multiple audience entries in BASIS_LOCAL_TOKEN_AUDIENCE if needed):
# BASIS_LOCAL_TOKEN_PUBLIC_KEYS_JSON={"basis-identity-key-1": "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
#
# Comma-separated algorithm allow-list. "none" and any symmetric "HS*"
# algorithm are always rejected regardless of this setting. Default: RS256.
# BASIS_LOCAL_TOKEN_ALLOWED_ALGORITHMS=RS256
#
# Clock-skew leeway in seconds applied to token timing validation. Default: 0.
# BASIS_LOCAL_TOKEN_LEEWAY_SECONDS=0

# ── Policy ────────────────────────────────────────────────────────────────────
# Required when evaluation is enabled (see above). Path to a JSON policy file.
# The file is loaded once at startup; the service will not become ready if
# the file is missing or invalid.
POLICY_PATH=policies/default.json

# Optional: version string included in evaluation responses and audit records.
# POLICY_VERSION=v1

# ── Audit failure escalation ──────────────────────────────────────────────────
# Consecutive audit write failures before audit_writer readiness degrades.
# Default: 10. Must be >= 1.
# AUDIT_FAILURE_THRESHOLD=10

# When true, a degraded audit writer causes /v1/evaluate to return 503 (fail-closed).
# Default: false (readiness degradation only — appropriate for OT environments).
# AUDIT_FAIL_CLOSED=false
